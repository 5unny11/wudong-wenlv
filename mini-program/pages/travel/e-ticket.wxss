.container { padding: 16px; min-height: 100vh; background: #f5f5f5; }
.back { font-size: 14px; color: #1677ff; margin-bottom: 12px; }
.banner { height: 180px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 16px; }
.ticket-detail-card { background: #fff; border-radius: 12px; padding: 24px; text-align: center; }
.ticket-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.ticket-main-title { font-size: 18px; font-weight: 700; }
.ticket-status { font-size: 12px; padding: 2px 10px; border-radius: 10px; }
.status-blue { background: #e6f4ff; color: #1677ff; }
.status-green { background: #f6ffed; color: #52c41a; }
.qr-area { width: 160px; height: 160px; border: 2px dashed #d9d9d9; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto 20px; }
.qr-icon { font-size: 32px; color: #1677ff; }
.qr-code { font-size: 11px; color: #999; margin-top: 8px; }
.ticket-info-list { text-align: left; }
.ticket-info-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; border-bottom: 1px solid #f0f0f0; }
.label { color: #999; }
.info-card { background: #fff; border-radius: 8px; padding: 14px; margin-bottom: 12px; }
.info-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
.section { margin: 16px 0 8px; }
.section-title { font-size: 16px; font-weight: 600; }
.intro-text { font-size: 13px; color: #666; line-height: 1.6; display: block; margin-bottom: 12px; }
.buy-btn-fixed { position: fixed; bottom: 20px; left: 16px; right: 16px; background: #ff4d4f; color: #fff; border: none; border-radius: 8px; padding: 14px; font-size: 16px; }
.notice-card { background: #fffbe6; border-radius: 8px; padding: 12px; font-size: 13px; color: #d48806; margin-bottom: 12px; }
