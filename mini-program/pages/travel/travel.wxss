.container { padding: 16px; min-height: 100vh; background: #f5f5f5; }
.header { margin-bottom: 20px; }
.title { font-size: 22px; font-weight: 700; display: block; }
.subtitle { font-size: 13px; color: #999; margin-top: 4px; display: block; }
.tabs { display: flex; gap: 8px; margin-bottom: 16px; background: #fff; border-radius: 8px; padding: 4px; }
.tab { flex: 1; text-align: center; padding: 8px 0; border-radius: 6px; font-size: 14px; color: #666; }
.tab.active { background: #1677ff; color: #fff; font-weight: 600; }
.loading { text-align: center; padding: 40px; color: #999; }
.empty { text-align: center; padding: 60px 20px; color: #999; font-size: 14px; }
.link { color: #1677ff; }
.list { display: flex; flex-direction: column; gap: 12px; }
.card { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.card-image { height: 140px; display: flex; align-items: center; justify-content: center; }
.spot-bg { background: linear-gradient(135deg, #43e97b, #38f9d7); }
.route-bg { background: linear-gradient(135deg, #667eea, #764ba2); }
.card-body { padding: 12px; }
.card-title { font-size: 16px; font-weight: 600; display: block; margin-bottom: 4px; }
.card-desc { font-size: 12px; color: #999; display: block; margin-bottom: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-footer { display: flex; justify-content: space-between; align-items: center; }
.card-tag { font-size: 11px; background: #f0f0f0; padding: 2px 8px; border-radius: 4px; color: #666; }
.card-price { font-size: 18px; color: #ff4d4f; font-weight: 600; }
.tag-blue { background: #e6f4ff; color: #1677ff; }
.tag-green { background: #f6ffed; color: #52c41a; }
.ticket-card .card-body { padding: 14px; }
.order-btn { position: fixed; bottom: 20px; left: 16px; right: 16px; background: #1677ff; color: #fff; text-align: center; padding: 12px; border-radius: 8px; font-size: 15px; }
