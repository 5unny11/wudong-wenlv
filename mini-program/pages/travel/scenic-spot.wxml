<view class="container">
  <view class="back" bindtap="goBack">← 返回</view>
  
  <view class="banner">{{spot.name}}</view>

  <view class="info-card">
    <view class="info-row"><text class="label">地址</text><text>{{spot.address || "乌东苗寨"}}</text></view>
    <view class="info-row"><text class="label">开放时间</text><text>{{spot.open_time || "全天"}}</text></view>
  </view>

  <view class="section"><text class="section-title">景区介绍</text></view>
  <text class="intro-text">{{spot.intro || "暂无介绍"}}</text>

  <view class="section"><text class="section-title">票种选择</text></view>
  <view class="list">
    <view class="ticket-item" wx:for="{{spot.tickets}}" wx:key="id">
      <view class="ticket-info">
        <text class="ticket-name">{{item.name}}</text>
        <text class="ticket-price">¥{{item.price}}</text>
      </view>
      <view class="ticket-action">
        <view class="qty-btn" data-id="{{item.id}}" data-op="minus" bindtap="changeQty">-</view>
        <text class="qty-num">{{quantities[item.id] || 0}}</text>
        <view class="qty-btn" data-id="{{item.id}}" data-op="plus" bindtap="changeQty">+</view>
      </view>
    </view>
  </view>

  <view class="buy-bar" wx:if="{{totalAmount > 0}}">
    <text class="total-text">合计: ¥{{totalAmount}}</text>
    <button class="buy-btn" bindtap="handleBuy">立即购买</button>
  </view>
</view>
