<view class="container">
  <view class="back" bindtap="goBack">← 返回</view>

  <view class="ticket-detail-card">
    <view class="ticket-header">
      <text class="ticket-main-title">电子票</text>
      <text class="ticket-status {{ticket.status === 0 ? "status-blue" : ticket.status === 1 ? "status-green" : ""}}">
        {{ticket.status === 0 ? "未使用" : ticket.status === 1 ? "已使用" : "已退款"}}
      </text>
    </view>

    <view class="qr-area">
      <text class="qr-icon">[二维码]</text>
      <text class="qr-code">{{ticket.qr_code}}</text>
    </view>

    <view class="ticket-info-list">
      <view class="ticket-info-row"><text class="label">票号</text><text>{{ticket.qr_code}}</text></view>
      <view class="ticket-info-row"><text class="label">有效期</text><text>{{ticket.valid_from}} ~ {{ticket.valid_to}}</text></view>
      <view class="ticket-info-row"><text class="label">状态</text><text>{{ticket.status === 0 ? "未使用" : ticket.status === 1 ? "已使用" : "已退款"}}</text></view>
      <view class="ticket-info-row" wx:if="{{ticket.used_at}}"><text class="label">使用时间</text><text>{{ticket.used_at}}</text></view>
    </view>
  </view>
</view>
