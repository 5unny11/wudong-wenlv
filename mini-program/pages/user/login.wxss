.container { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f5f5f5; padding: 20px; }
.card { background: #fff; border-radius: 12px; padding: 40px 24px; width: 100%; max-width: 360px; text-align: center; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
.title { font-size: 24px; font-weight: 700; display: block; margin-bottom: 4px; }
.subtitle { font-size: 13px; color: #999; display: block; margin-bottom: 30px; }
.form { display: flex; flex-direction: column; gap: 14px; }
.input { border: 1px solid #e8e8e8; border-radius: 8px; padding: 12px 14px; font-size: 15px; width: 100%; box-sizing: border-box; }
.login-btn { background: #1677ff; color: #fff; border: none; border-radius: 8px; padding: 12px; font-size: 16px; width: 100%; }
.register-link { background: transparent; border: none; font-size: 13px; color: #1677ff; padding: 8px; }
