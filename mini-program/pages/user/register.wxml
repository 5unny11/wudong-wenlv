<view class="container">
  <view class="card">
    <text class="title">注册</text>
    <text class="subtitle">创建乌东文旅账号</text>

    <view class="form">
      <input class="input" placeholder="手机号" value="{{phone}}" bindinput="onPhoneInput" type="number" maxlength="11" />
      <input class="input" placeholder="密码" value="{{password}}" bindinput="onPasswordInput" type="password" />
      <input class="input" placeholder="确认密码" value="{{confirmPassword}}" bindinput="onConfirmInput" type="password" />

      <button class="login-btn" bindtap="handleRegister">注册</button>
      <button class="register-link" bindtap="goBack">已有账号？去登录</button>
    </view>
  </view>
</view>
